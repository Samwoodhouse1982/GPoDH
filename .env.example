# Copy to .env.local for local dev, and set the same values in Vercel
# (Project → Settings → Environment Variables). Do NOT commit real secrets.

# --- Decap CMS (GitHub OAuth) ---------------------------------------------
# Used by the /admin login flow. See HANDOFF for setup.
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=

# --- Web3Forms (contact + subscribe forms) --------------------------------
# One access key powers every form on the site. Create one at
# https://web3forms.com (enter the destination email, copy the access key).
# This is PUBLIC by design — it ships in the client HTML — so NEXT_PUBLIC is
# correct. After setting it in Vercel you must redeploy for it to take effect.
NEXT_PUBLIC_WEB3FORMS_ACCESS_KEY=
